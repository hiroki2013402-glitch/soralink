NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
COOKIE_SECRET=replace_with_a_long_random_secret_at_least_32_chars
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token
# Separate Turso database used only for video binary chunks (do not reuse the main DB).
VIDEO_TURSO_DATABASE_URL=libsql://your-video-database-your-org.turso.io
VIDEO_TURSO_AUTH_TOKEN=your_video_turso_auth_token
SENNIN_CLIENT_ID=
SENNIN_CLIENT_SECRET=
SENNIN_REDIRECT_URI=http://localhost:3000/api/auth/callback
SENNIN_AUTHORIZATION_URL=https://script.google.com/macros/s/AKfycbzSlcCC1kI2TE63DqkhNACg9Bw8gVFs0Ca7loctMU_iiHThX8fnYC2FL_W4Vx70WESG/exec
SENNIN_TOKEN_URL=https://sennin-account-api.xianrendesu.workers.dev/oauth/token
SENNIN_USERINFO_URL=https://sennin-account-api.xianrendesu.workers.dev/oauth/userinfo
SENNIN_ME_URL=https://sennin-account-api.xianrendesu.workers.dev/api/v1/me
SENNIN_SCOPE=profile email

# Supabase (direct messages and notes)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Admin area (/admin). Leave ADMIN_PASSWORD empty to keep the admin screen disabled.
# ADMIN_SENNIN_ID is required when ADMIN_PASSWORD is set: the raw Sennin Account user id that may become admin.
ADMIN_PASSWORD=
ADMIN_SENNIN_ID=

# Web Push notifications for direct messages. Generate with: npx web-push generate-vapid-keys
# Leave both empty to turn push notifications off. VAPID_SUBJECT is a mailto: or https: contact address.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
